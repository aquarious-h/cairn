# Use a Google AI Studio Free Tier project; the server uses gemini-3.8-flash only.
# Never prefix this key with VITE_ or commit it.
GEMINI_API_KEY=

# Public Firebase web configuration. Defaults are provided in the client.
# Set these only when using a different Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
