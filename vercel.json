{
  "buildCommand": "pnpm --filter @workspace/api-server build && pnpm --filter @workspace/career-copilot build",
  "installCommand": "pnpm install --frozen-lockfile --filter \"@workspace/career-copilot...\" --filter \"@workspace/api-server...\"",
  "outputDirectory": "artifacts/career-copilot/dist/public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

{
  "services": {
    "my_frontend": {
      "root": "cairn/artifacts/career-copilot"
    },
    "my_backend": {
      "root": "cairn/artifacts/api-server",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "cairn/artifacts/api-server": { "service": "my_backend" } },
    { "source": "/(.*)", "cairn/artifacts/career-copilot": { "service": "my_frontend" } }
  ]
}
