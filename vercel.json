{
  "buildCommand": "pnpm --filter @workspace/career-copilot build",
  "installCommand": "pnpm install --frozen-lockfile --filter \"@workspace/career-copilot...\" --filter \"@workspace/api-server...\"",
  "outputDirectory": "artifacts/career-copilot/dist/public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
